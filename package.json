{
  "name": "kyc-review-console",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "packages/*",
    "variants/*"
  ],
  "scripts": {
    "dev:server": "npm run dev -w packages/server",
    "seed": "npm run seed -w packages/server",
    "seed:refunds": "npm run seed:refunds -w packages/server",
    "seed:logins": "npm run seed:logins -w packages/server",
    "test": "npm run test -w packages/server && npm run test -w packages/web",
    "lint": "npm run lint -w packages/server && npm run lint -w packages/web",
    "typecheck": "npm run typecheck -w packages/server && npm run typecheck -w packages/web",
    "dev:web": "npm run dev -w packages/web",
    "build:web": "npm run build -w packages/web",
    "lint:web": "npm run lint -w packages/web",
    "typecheck:web": "npm run typecheck -w packages/web",
    "test:web": "npm run test -w packages/web",
    "dev:web-b": "npm run dev -w variants/web-b",
    "build:web-b": "npm run build -w variants/web-b",
    "lint:web-b": "npm run lint -w variants/web-b",
    "typecheck:web-b": "npm run typecheck -w variants/web-b",
    "test:web-b": "npm run test -w variants/web-b",
    "dev:web-c": "npm run dev -w variants/web-c",
    "build:web-c": "npm run build -w variants/web-c",
    "lint:web-c": "npm run lint -w variants/web-c",
    "typecheck:web-c": "npm run typecheck -w variants/web-c",
    "test:web-c": "npm run test -w variants/web-c"
  }
}
